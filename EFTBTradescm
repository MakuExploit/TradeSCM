-- Button Creator (UNCHANGED)
local function createButton(name, baseColor, layoutOrder)
    local button = Instance.new("TextButton")
    button.Size               = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3   = baseColor
    button.BorderSizePixel    = 0
    button.Font               = Enum.Font.GothamSemibold
    button.Text               = name
    button.TextColor3         = Color3.fromRGB(255, 255, 100)
    button.TextSize           = 15
    button.AutoButtonColor    = false
    button.LayoutOrder        = layoutOrder
    button.Parent = buttonsContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 11)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255,255,255)
    stroke.Thickness = 1.7
    stroke.Transparency = 0.35
    stroke.Parent = button

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
        ColorSequenceKeypoint.new(1, baseColor)
    }
    grad.Rotation = -90
    grad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0,0.35),
        NumberSequenceKeypoint.new(1,0.75)
    }
    grad.Parent = button

    local isActive = false
    local activeColor = Color3.fromRGB(0, 255, 145)

    local function refresh()
        if isActive then
            TweenService:Create(button, TweenInfo.new(0.25), {BackgroundColor3 = activeColor}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(0,255,255), Transparency = 0.1}):Play()
        else
            TweenService:Create(button, TweenInfo.new(0.25), {BackgroundColor3 = baseColor}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(255,255,255), Transparency = 0.35}):Play()
        end
    end

    button.MouseButton1Click:Connect(function()
        isActive = not isActive
        refresh()
    end)

    button.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.15}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = isActive and 0.1 or 0.35}):Play()
    end)

    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {Size = UDim2.new(1,0,0,36)}):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,38)}):Play()
    end)

    refresh()
end

