-- Button Creator with Progress Bar
local function createButton(text, layoutOrder)
    local buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(1, 0, 0, 58)
    buttonFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    buttonFrame.BorderSizePixel = 0
    buttonFrame.LayoutOrder = layoutOrder
    buttonFrame.Parent = buttonsContainer

    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 13)
    frameCorner.Parent = buttonFrame

    local frameStroke = Instance.new("UIStroke")
    frameStroke.Color = Color3.fromRGB(45, 45, 58)
    frameStroke.Thickness = 1.5
    frameStroke.Transparency = 0.6
    frameStroke.Parent = buttonFrame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Font = Enum.Font.GothamSemibold
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 16.5
    button.AutoButtonColor = false
    button.Parent = buttonFrame

    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(0, 0, 0, 4)
    progressBar.Position = UDim2.new(0, 0, 1, -4)
    progressBar.BackgroundColor3 = Color3.fromRGB(100, 160, 255)
    progressBar.BorderSizePixel = 0
    progressBar.Parent = buttonFrame

    local progressCorner = Instance.new("UICorner")
    progressCorner.CornerRadius = UDim.new(0, 2)
    progressCorner.Parent = progressBar

    local isCooldown = false

    local function startCooldown()
        if isCooldown then return end
        isCooldown = true

        local cooldownTime = 5
        local startTime = tick()

        button.TextColor3 = Color3.fromRGB(170, 170, 190)
        progressBar.Size = UDim2.new(1, 0, 0, 4)

        TweenService:Create(progressBar, TweenInfo.new(cooldownTime, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 0, 4)
        }):Play()

        spawn(function()
            while isCooldown do
                local elapsed = tick() - startTime
                local remaining = math.max(0, cooldownTime - math.floor(elapsed))
                if remaining > 0 then
                    button.Text = text .. " (" .. remaining .. "s)"
                else
                    button.Text = text
                    button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    progressBar.Size = UDim2.new(0, 0, 0, 4)
                    isCooldown = false
                    break
                end
                task.wait(0.1)
            end
        end)
    end

    button.MouseButton1Click:Connect(function()
        if isCooldown then return end
        startCooldown()
        
        if text == "Steal Brainrot" then
            print("💀 Steal Brainrot activated!")
            -- YOUR STEAL BRAINROT CODE HERE
        elseif text == "Force Accept" then
            print("✅ Force Accept activated!")
            -- YOUR FORCE ACCEPT CODE HERE
        end
    end)

    -- Hover
    button.MouseEnter:Connect(function()
        if not isCooldown then
            TweenService:Create(buttonFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(32, 32, 44)}):Play()
            TweenService:Create(frameStroke, TweenInfo.new(0.2), {Transparency = 0.35}):Play()
        end
    end)

    button.MouseLeave:Connect(function()
        if not isCooldown then
            TweenService:Create(buttonFrame, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(24, 24, 34)}):Play()
            TweenService:Create(frameStroke, TweenInfo.new(0.25), {Transparency = 0.6}):Play()
        end
    end)
end

createButton("Steal Brainrot", 1)
createButton("Force Accept", 2)

