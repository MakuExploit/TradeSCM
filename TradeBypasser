-- Smaller Action Buttons
local function createButton(name, order)
    local btnFrame = Instance.new("Frame")
    btnFrame.Size = UDim2.new(1, 0, 0, 50)  -- Smaller
    btnFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    btnFrame.LayoutOrder = order
    btnFrame.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = btnFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 70, 90)
    stroke.Thickness = 1.5
    stroke.Parent = btnFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15.5
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = btnFrame

    local isCooldown = false

    btn.MouseButton1Click:Connect(function()
        if isCooldown then return end
        isCooldown = true

        btn.Text = name .. " (5s)"
        TweenService:Create(btnFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 65)}):Play()

        task.delay(5, function()
            isCooldown = false
            btn.Text = name
            TweenService:Create(btnFrame, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(25, 25, 40)}):Play()
        end)

        if name == "Add Brainrot" then
            print("🧠 Add Brainrot activated!")
        elseif name == "Auto Accept" then
            print("✅ Auto Accept activated!")
        end
    end)

    btn.MouseEnter:Connect(function()
        if not isCooldown then
            TweenService:Create(btnFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 55)}):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if not isCooldown then
            TweenService:Create(btnFrame, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(25, 25, 40)}):Play()
        end
    end)
end

createButton("Add Brainrot", 2)
createButton("Auto Accept", 3)

